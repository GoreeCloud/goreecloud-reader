{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/reader/listening-progress.schema.json",
  "title": "GoreeCloud Reader Listening Progress",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_id", "position_ms", "updated_at"],
  "properties": {
    "item_id": { "type": "string", "minLength": 1 },
    "chapter": { "type": ["string", "null"] },
    "position_ms": { "type": "integer", "minimum": 0 },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "playback_speed": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 },
    "fraction_completed": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
